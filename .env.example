APP_NAME="Affiliate Leaderboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=file
CACHE_STORE=file

# --- Refersion API -----------------------------------------------------------
# Defaults target the local mock container (`make up` starts it on :8080), so the
# app works out of the box. To use a real account, replace these four lines with:
#   REFERSION_BASE_URL=https://api.refersion.com/v2026-08
#   REFERSION_TOKEN_URL=https://auth.refersion.com/oauth/token
#   REFERSION_CLIENT_ID=<your client id>
#   REFERSION_CLIENT_SECRET=<your client secret>
# Real credentials go in .env only (git-ignored). Never commit them.
REFERSION_BASE_URL=http://mock:8080/v2026-08
REFERSION_TOKEN_URL=http://mock:8080/oauth/token
REFERSION_CLIENT_ID=mock-client-id
REFERSION_CLIENT_SECRET=mock-client-secret

REFERSION_PAGE_LIMIT=100
REFERSION_MAX_PAGES=1000
REFERSION_BATCH_SIZE=5

# --- Leaderboard -------------------------------------------------------------
LEADERBOARD_CACHE_TTL=300

VITE_APP_NAME="${APP_NAME}"
